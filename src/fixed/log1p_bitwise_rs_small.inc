    }

#undef LP

    /* t = D 2^(FLINT_BITS 5) / (X + P) */
    add_ssssssaaaaaaaaaaaa(S[5], S[4], S[3], S[2], S[1], S[0],
        UWORD(1), x[4], x[3], x[2], x[1], x[0],
        UWORD(1), p4, p3, p2, p1, p0);
