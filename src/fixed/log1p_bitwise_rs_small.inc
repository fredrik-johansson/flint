            }
            v0 = MPN_RIGHT_SHIFT_LOW(UWORD(1), p4, b);
            sub_dddmmmsss(bw, e1, e0,
                UWORD(0), d1, d0,
                UWORD(0), UWORD(0), v0);
            m = ~bw;                /* accept iff no borrow */
            d0 = (d0 & bw) | (e0 & m);
            d1 = (d1 & bw) | (e1 & m);
