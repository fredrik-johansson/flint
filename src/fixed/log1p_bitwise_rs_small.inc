            }
            v0 = MPN_RIGHT_SHIFT_LOW(p4, p3, b);
            v1 = MPN_RIGHT_SHIFT_LOW(p5, p4, b);
            v2 = MPN_RIGHT_SHIFT_LOW(UWORD(1), p5, b);
            sub_dddddmmmmmsssss(bw, e3, e2, e1, e0,
                UWORD(0), d3, d2, d1, d0,
                UWORD(0), UWORD(0), v2, v1, v0);
            m = ~bw;                /* accept iff no borrow */
            d0 = (d0 & bw) | (e0 & m);
            d1 = (d1 & bw) | (e1 & m);
            d2 = (d2 & bw) | (e2 & m);
            d3 = (d3 & bw) | (e3 & m);
            add_ssssssaaaaaaaaaaaa(p5, p4, p3, p2, p1, p0,
                p5, p4, p3, p2, p1, p0,
                UWORD(0), UWORD(0), UWORD(0), (v2) & m, (v1) & m, (v0) & m);
            add_ssssssaaaaaaaaaaaa(a5, a4, a3, a2, a1, a0,
                a5, a4, a3, a2, a1, a0,
                Lp[5] & m, Lp[4] & m, Lp[3] & m, Lp[2] & m, Lp[1] & m, Lp[0] & m);
            break;
        case 4:
            if (b == 0)
            {
                sub_ddddmmmmssss(bw, e2, e1, e0,
                    UWORD(0), d2, d1, d0,
                    UWORD(0), UWORD(1), p5, p4);
                m = ~bw;                /* accept iff no borrow */
                d0 = (d0 & bw) | (e0 & m);
                d1 = (d1 & bw) | (e1 & m);
                d2 = (d2 & bw) | (e2 & m);
                add_ssssssaaaaaaaaaaaa(p5, p4, p3, p2, p1, p0,
                    p5, p4, p3, p2, p1, p0,
                    UWORD(0), UWORD(0), UWORD(0), (UWORD(1)) & m, (p5) & m, (p4) & m);
                add_ssssssaaaaaaaaaaaa(a5, a4, a3, a2, a1, a0,
                    a5, a4, a3, a2, a1, a0,
                    Lp[5] & m, Lp[4] & m, Lp[3] & m, Lp[2] & m, Lp[1] & m, Lp[0] & m);
                break;
            }
            v0 = MPN_RIGHT_SHIFT_LOW(p5, p4, b);
            v1 = MPN_RIGHT_SHIFT_LOW(UWORD(1), p5, b);
            sub_ddddmmmmssss(bw, e2, e1, e0,
                UWORD(0), d2, d1, d0,
                UWORD(0), UWORD(0), v1, v0);
            m = ~bw;                /* accept iff no borrow */
            d0 = (d0 & bw) | (e0 & m);
            d1 = (d1 & bw) | (e1 & m);
            d2 = (d2 & bw) | (e2 & m);
            add_ssssssaaaaaaaaaaaa(p5, p4, p3, p2, p1, p0,
                p5, p4, p3, p2, p1, p0,
                UWORD(0), UWORD(0), UWORD(0), UWORD(0), (v1) & m, (v0) & m);
            add_ssssssaaaaaaaaaaaa(a5, a4, a3, a2, a1, a0,
                a5, a4, a3, a2, a1, a0,
                Lp[5] & m, Lp[4] & m, Lp[3] & m, Lp[2] & m, Lp[1] & m, Lp[0] & m);
            break;
        case 5:
            if (b == 0)
            {
                sub_dddmmmsss(bw, e1, e0,
                    UWORD(0), d1, d0,
                    UWORD(0), UWORD(1), p5);
                m = ~bw;                /* accept iff no borrow */
                d0 = (d0 & bw) | (e0 & m);
                d1 = (d1 & bw) | (e1 & m);
                add_ssssssaaaaaaaaaaaa(p5, p4, p3, p2, p1, p0,
                    p5, p4, p3, p2, p1, p0,
                    UWORD(0), UWORD(0), UWORD(0), UWORD(0), (UWORD(1)) & m, (p5) & m);
                add_ssssssaaaaaaaaaaaa(a5, a4, a3, a2, a1, a0,
                    a5, a4, a3, a2, a1, a0,
                    Lp[5] & m, Lp[4] & m, Lp[3] & m, Lp[2] & m, Lp[1] & m, Lp[0] & m);
                break;
            }
            v0 = MPN_RIGHT_SHIFT_LOW(UWORD(1), p5, b);
            sub_dddmmmsss(bw, e1, e0,
                UWORD(0), d1, d0,
                UWORD(0), UWORD(0), v0);
            m = ~bw;                /* accept iff no borrow */
            d0 = (d0 & bw) | (e0 & m);
            d1 = (d1 & bw) | (e1 & m);
            add_ssssssaaaaaaaaaaaa(p5, p4, p3, p2, p1, p0,
                p5, p4, p3, p2, p1, p0,
                UWORD(0), UWORD(0), UWORD(0), UWORD(0), UWORD(0), (v0) & m);
            add_ssssssaaaaaaaaaaaa(a5, a4, a3, a2, a1, a0,
                a5, a4, a3, a2, a1, a0,
                Lp[5] & m, Lp[4] & m, Lp[3] & m, Lp[2] & m, Lp[1] & m, Lp[0] & m);
            break;
        }
    }

#undef LP

    /* t = D 2^(FLINT_BITS 6) / (X + P) */
    add_sssssssaaaaaaaaaaaaaa(S[6], S[5], S[4], S[3], S[2], S[1], S[0],
        UWORD(1), x[5], x[4], x[3], x[2], x[1], x[0],
        UWORD(1), p5, p4, p3, p2, p1, p0);
    nd[0] = 0;
    nd[1] = 0;
    nd[2] = 0;
    nd[3] = 0;
    nd[4] = 0;
    nd[5] = 0;
    nd[6] = d0;
    nd[7] = d1;
    nd[8] = d2;
    nd[9] = d3;
    nd[10] = d4;
    nd[11] = d5;
    flint_mpn_zero(t, 6);
    if (d5 != 0 || d4 != 0 || d3 != 0 || d2 != 0 || d1 != 0 || d0 != 0)
        mpn_tdiv_qr(t, nd, 0, nd, 12, S, 7);

    if (r < 32)
        _fixed_atanh_rs16(y, t, 6);
    else
        fixed_atanh_rs(y, t, 6);

    add_ssssssaaaaaaaaaaaa(res[5], res[4], res[3], res[2], res[1], res[0],
        a5, a4, a3, a2, a1, a0,
        (y[5] << 1) | (y[4] >> (FLINT_BITS - 1)), (y[4] << 1) | (y[3] >> (FLINT_BITS - 1)), (y[3] << 1) | (y[2] >> (FLINT_BITS - 1)), (y[2] << 1) | (y[1] >> (FLINT_BITS - 1)), (y[1] << 1) | (y[0] >> (FLINT_BITS - 1)), y[0] << 1);
}

static void
_fixed_log1p_bitwise_rs_7(nn_ptr res, nn_srcptr x, int r)
{
    ulong d0, d1, d2, d3, d4, d5, d6;
    ulong p0, p1, p2, p3, p4, p5, p6;
    ulong a0, a1, a2, a3, a4, a5, a6;
    ulong e0, e1, e2, e3, e4, e5, e6;
    ulong v0, v1, v2, v3, v4, v5, v6;
    ulong bw, m, h, lt;
    ulong S[8], nd[14], t[7], y[7];
    slong i, nc;

    r = FLINT_MAX(r, 32);
    r = FLINT_MIN(r, FLINT_BITS * 7 - 16);

    _fixed_exp_logs_ensure(7, r);
    nc = _fixed_exp_logs_n;

    d0 = x[0];
    d1 = x[1];
    d2 = x[2];
    d3 = x[3];
    d4 = x[4];
    d5 = x[5];
    d6 = x[6];
    p0 = 0;
    p1 = 0;
    p2 = 0;
    p3 = 0;
    p4 = 0;
    p5 = 0;
    p6 = 0;
    a0 = 0;
    a1 = 0;
    a2 = 0;
    a3 = 0;
    a4 = 0;
    a5 = 0;
    a6 = 0;

#define LP(ii) (_fixed_exp_logs + (ii) * nc + (nc - 7))

    /* window 0 */
    {
        nn_srcptr Lp;

        /* boundary step i = 1 */
        Lp = LP(1);
        v0 = MPN_RIGHT_SHIFT_LOW(p1, p0, 1);
        v1 = MPN_RIGHT_SHIFT_LOW(p2, p1, 1);
        v2 = MPN_RIGHT_SHIFT_LOW(p3, p2, 1);
        v3 = MPN_RIGHT_SHIFT_LOW(p4, p3, 1);
        v4 = MPN_RIGHT_SHIFT_LOW(p5, p4, 1);
        v5 = MPN_RIGHT_SHIFT_LOW(p6, p5, 1);
        v6 = MPN_RIGHT_SHIFT_LOW(UWORD(1), p6, 1);
        sub_ddddddddmmmmmmmmssssssss(bw, e6, e5, e4, e3, e2, e1, e0,
            UWORD(0), d6, d5, d4, d3, d2, d1, d0,
            UWORD(0), v6, v5, v4, v3, v2, v1, v0);
        m = ~bw;                /* accept iff no borrow */
        d0 = (d0 & bw) | (e0 & m);
        d1 = (d1 & bw) | (e1 & m);
        d2 = (d2 & bw) | (e2 & m);
        d3 = (d3 & bw) | (e3 & m);
        d4 = (d4 & bw) | (e4 & m);
        d5 = (d5 & bw) | (e5 & m);
        d6 = (d6 & bw) | (e6 & m);
        add_sssssssaaaaaaaaaaaaaa(p6, p5, p4, p3, p2, p1, p0,
            p6, p5, p4, p3, p2, p1, p0,
            (v6) & m, (v5) & m, (v4) & m, (v3) & m, (v2) & m, (v1) & m, (v0) & m);
        add_sssssssaaaaaaaaaaaaaa(a6, a5, a4, a3, a2, a1, a0,
            a6, a5, a4, a3, a2, a1, a0,
            Lp[6] & m, Lp[5] & m, Lp[4] & m, Lp[3] & m, Lp[2] & m, Lp[1] & m, Lp[0] & m);

        h = d6;

        for (i = 2; i <= FLINT_MIN((slong) r, 63); i++)
        {
            int b = (int) (i - 0);

            lt = MPN_RIGHT_SHIFT_LOW(UWORD(1), p6, b);
            if (h < lt)
                continue;    /* certain reject */

            Lp = LP(i);
            v0 = MPN_RIGHT_SHIFT_LOW(p1, p0, b);
            v1 = MPN_RIGHT_SHIFT_LOW(p2, p1, b);
            v2 = MPN_RIGHT_SHIFT_LOW(p3, p2, b);
