                    UWORD(0), UWORD(1), p6, p5, p4);
                m = ~bw;                /* accept iff no borrow */
                d0 = (d0 & bw) | (e0 & m);
                d1 = (d1 & bw) | (e1 & m);
                d2 = (d2 & bw) | (e2 & m);
                d3 = (d3 & bw) | (e3 & m);
                add_sssssssaaaaaaaaaaaaaa(p6, p5, p4, p3, p2, p1, p0,
                    p6, p5, p4, p3, p2, p1, p0,
                    UWORD(0), UWORD(0), UWORD(0), (UWORD(1)) & m, (p6) & m, (p5) & m, (p4) & m);
                add_sssssssaaaaaaaaaaaaaa(a6, a5, a4, a3, a2, a1, a0,
                    a6, a5, a4, a3, a2, a1, a0,
                    Lp[6] & m, Lp[5] & m, Lp[4] & m, Lp[3] & m, Lp[2] & m, Lp[1] & m, Lp[0] & m);
                break;
            }
            v0 = MPN_RIGHT_SHIFT_LOW(p5, p4, b);
            v1 = MPN_RIGHT_SHIFT_LOW(p6, p5, b);
            v2 = MPN_RIGHT_SHIFT_LOW(UWORD(1), p6, b);
            sub_dddddmmmmmsssss(bw, e3, e2, e1, e0,
                UWORD(0), d3, d2, d1, d0,
                UWORD(0), UWORD(0), v2, v1, v0);
            m = ~bw;                /* accept iff no borrow */
            d0 = (d0 & bw) | (e0 & m);
            d1 = (d1 & bw) | (e1 & m);
            d2 = (d2 & bw) | (e2 & m);
            d3 = (d3 & bw) | (e3 & m);
            add_sssssssaaaaaaaaaaaaaa(p6, p5, p4, p3, p2, p1, p0,
                p6, p5, p4, p3, p2, p1, p0,
                UWORD(0), UWORD(0), UWORD(0), UWORD(0), (v2) & m, (v1) & m, (v0) & m);
            add_sssssssaaaaaaaaaaaaaa(a6, a5, a4, a3, a2, a1, a0,
                a6, a5, a4, a3, a2, a1, a0,
