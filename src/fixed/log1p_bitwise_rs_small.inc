    nd[0] = 0;
    nd[1] = 0;
    nd[2] = 0;
    nd[3] = 0;
    nd[4] = 0;
    nd[5] = 0;
    nd[6] = 0;
    nd[7] = d0;
    nd[8] = d1;
    nd[9] = d2;
    nd[10] = d3;
    nd[11] = d4;
    nd[12] = d5;
    nd[13] = d6;
