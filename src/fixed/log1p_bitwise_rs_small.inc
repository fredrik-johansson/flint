            d2 = (d2 & bw) | (e2 & m);
            d3 = (d3 & bw) | (e3 & m);
            d4 = (d4 & bw) | (e4 & m);
            d5 = (d5 & bw) | (e5 & m);
            d6 = (d6 & bw) | (e6 & m);
            add_sssssssaaaaaaaaaaaaaa(p6, p5, p4, p3, p2, p1, p0,
                p6, p5, p4, p3, p2, p1, p0,
                UWORD(0), (v5) & m, (v4) & m, (v3) & m, (v2) & m, (v1) & m, (v0) & m);
