    if (r < 32)
        _fixed_atanh_rs16(y, t, 7);
    else
        fixed_atanh_rs(y, t, 7);

    add_sssssssaaaaaaaaaaaaaa(res[6], res[5], res[4], res[3], res[2], res[1], res[0],
