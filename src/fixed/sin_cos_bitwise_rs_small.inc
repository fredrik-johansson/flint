            case 4:
                if (b == 0)
                {
                    u0 = p4;
                    u1 = wu;
                    u2 = UWORD(0);
                    u3 = UWORD(0);
                    u4 = UWORD(0);
                    v0 = q4;
                    v1 = UWORD(0);
                    v2 = UWORD(0);
                    v3 = UWORD(0);
                    v4 = UWORD(0);
                    sub_ddddddmmmmmmssssss(bw, e4, e3, e2, e1, e0,
                        UWORD(0), t4, t3, t2, t1, t0,
                        UWORD(0), Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
                    m = ~bw;                /* accept iff no borrow */
                    t0 = (t0 & bw) | (e0 & m);
                    t1 = (t1 & bw) | (e1 & m);
                    t2 = (t2 & bw) | (e2 & m);
                    t3 = (t3 & bw) | (e3 & m);
