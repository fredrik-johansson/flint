                        u4 & m, u3 & m, u2 & m, u1 & m, u0 & m);
                    break;
                }
                u0 = MPN_RIGHT_SHIFT_LOW(p3, p2, b);
                u1 = MPN_RIGHT_SHIFT_LOW(p4, p3, b);
                u2 = MPN_RIGHT_SHIFT_LOW(wu, p4, b);
                u3 = UWORD(0);
                u4 = UWORD(0);
                v0 = MPN_RIGHT_SHIFT_LOW(q3, q2, b);
                v1 = MPN_RIGHT_SHIFT_LOW(q4, q3, b);
                v2 = MPN_RIGHT_SHIFT_LOW(UWORD(0), q4, b);
                v3 = UWORD(0);
                v4 = UWORD(0);
                sub_ddddddmmmmmmssssss(bw, e4, e3, e2, e1, e0,
                    UWORD(0), t4, t3, t2, t1, t0,
                    UWORD(0), Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
                m = ~bw;                /* accept iff no borrow */
                t0 = (t0 & bw) | (e0 & m);
                t1 = (t1 & bw) | (e1 & m);
                t2 = (t2 & bw) | (e2 & m);
                t3 = (t3 & bw) | (e3 & m);
                t4 = (t4 & bw) | (e4 & m);
                sub_ddddddmmmmmmssssss(wu, p4, p3, p2, p1, p0,
                    wu, p4, p3, p2, p1, p0,
                    UWORD(0), v4 & m, v3 & m, v2 & m, v1 & m, v0 & m);
                add_sssssaaaaaaaaaa(q4, q3, q2, q1, q0,
                    q4, q3, q2, q1, q0,
                    u4 & m, u3 & m, u2 & m, u1 & m, u0 & m);
                break;
            case 3:
                if (b == 0)
                {
                    u0 = p3;
                    u1 = p4;
                    u2 = wu;
                    u3 = UWORD(0);
                    u4 = UWORD(0);
                    v0 = q3;
                    v1 = q4;
                    v2 = UWORD(0);
                    v3 = UWORD(0);
                    v4 = UWORD(0);
                    sub_ddddddmmmmmmssssss(bw, e4, e3, e2, e1, e0,
                        UWORD(0), t4, t3, t2, t1, t0,
                        UWORD(0), Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
                    m = ~bw;                /* accept iff no borrow */
                    t0 = (t0 & bw) | (e0 & m);
