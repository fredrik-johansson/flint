                m = ~bw;                /* accept iff no borrow */
                t0 = (t0 & bw) | (e0 & m);
                t1 = (t1 & bw) | (e1 & m);
                t2 = (t2 & bw) | (e2 & m);
                t3 = (t3 & bw) | (e3 & m);
                t4 = (t4 & bw) | (e4 & m);
                sub_ddddddmmmmmmssssss(wu, p4, p3, p2, p1, p0,
                    wu, p4, p3, p2, p1, p0,
