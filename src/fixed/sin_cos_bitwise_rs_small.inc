#undef AP

    /* the residual angle is twice the reduced remainder */
    tt[0] = t0;
    tt[1] = t1;
    tt[2] = t2;
    tt[3] = t3;
    tt[4] = t4;
    mpn_lshift(tt, tt, 5, 1);

    if (r < 32)
        _fixed_sin_cos_rs16(sr, cr, tt, 5);
