static void
_fixed_sin_cos_bitwise_rs_6(nn_ptr ysin, nn_ptr ycos,
    nn_srcptr x, int r)
{
    ulong t0, t1, t2, t3, t4, t5;
    ulong p0, p1, p2, p3, p4, p5;
    ulong q0, q1, q2, q3, q4, q5;
    ulong e0, e1, e2, e3, e4, e5;
    ulong u0, u1, u2, u3, u4, u5;
    ulong v0, v1, v2, v3, v4, v5;
    ulong wu, bw, m, h, lt;
    ulong tt[6], sr[7], cr[7];
    ulong wx[7], wy[7];
    slong i, nc, R;
    int pass;

    r = FLINT_MAX(r, 16);
    r = FLINT_MIN(r, FLINT_BITS * 6 - 16);
    R = (slong) r + 1;

    _fixed_atans_ensure(6, R);
    nc = _fixed_atans_n;

    /* t = x / 2 (the table holds the undoubled angles) */
    mpn_rshift(tt, x, 6, 1);
    t0 = tt[0];
    t1 = tt[1];
    t2 = tt[2];
    t3 = tt[3];
    t4 = tt[4];
    t5 = tt[5];

    wu = 1;
    p0 = 0;
    p1 = 0;
    p2 = 0;
    p3 = 0;
    p4 = 0;
    p5 = 0;
    q0 = 0;
    q1 = 0;
    q2 = 0;
    q3 = 0;
    q4 = 0;
    q5 = 0;

#define AP(ii) (_fixed_atans + (ii) * nc + (nc - 6))

    /* window 0 */
    {
        nn_srcptr Ap;

        /* boundary step i = 1, twice (truncation creep) */
        Ap = AP(1);
        for (pass = 0; pass < 2; pass++)
        {
            u0 = MPN_RIGHT_SHIFT_LOW(p1, p0, 1);
            u1 = MPN_RIGHT_SHIFT_LOW(p2, p1, 1);
            u2 = MPN_RIGHT_SHIFT_LOW(p3, p2, 1);
            u3 = MPN_RIGHT_SHIFT_LOW(p4, p3, 1);
            u4 = MPN_RIGHT_SHIFT_LOW(p5, p4, 1);
            u5 = MPN_RIGHT_SHIFT_LOW(wu, p5, 1);
            v0 = MPN_RIGHT_SHIFT_LOW(q1, q0, 1);
            v1 = MPN_RIGHT_SHIFT_LOW(q2, q1, 1);
            v2 = MPN_RIGHT_SHIFT_LOW(q3, q2, 1);
            v3 = MPN_RIGHT_SHIFT_LOW(q4, q3, 1);
            v4 = MPN_RIGHT_SHIFT_LOW(q5, q4, 1);
            v5 = MPN_RIGHT_SHIFT_LOW(UWORD(0), q5, 1);
            sub_dddddddmmmmmmmsssssss(bw, e5, e4, e3, e2, e1, e0,
                UWORD(0), t5, t4, t3, t2, t1, t0,
                UWORD(0), Ap[5], Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
            m = ~bw;                /* accept iff no borrow */
            t0 = (t0 & bw) | (e0 & m);
            t1 = (t1 & bw) | (e1 & m);
            t2 = (t2 & bw) | (e2 & m);
            t3 = (t3 & bw) | (e3 & m);
            t4 = (t4 & bw) | (e4 & m);
            t5 = (t5 & bw) | (e5 & m);
            sub_dddddddmmmmmmmsssssss(wu, p5, p4, p3, p2, p1, p0,
                wu, p5, p4, p3, p2, p1, p0,
                UWORD(0), v5 & m, v4 & m, v3 & m, v2 & m, v1 & m, v0 & m);
            add_ssssssaaaaaaaaaaaa(q5, q4, q3, q2, q1, q0,
                q5, q4, q3, q2, q1, q0,
                u5 & m, u4 & m, u3 & m, u2 & m, u1 & m, u0 & m);
        }

        h = t5;

        for (i = 2; i <= FLINT_MIN(R, 63); i++)
        {
            int b = (int) (i - 0);

            Ap = AP(i);
            lt = Ap[5];
            if (h < lt)
                continue;    /* certain reject */

            u0 = MPN_RIGHT_SHIFT_LOW(p1, p0, b);
            u1 = MPN_RIGHT_SHIFT_LOW(p2, p1, b);
            u2 = MPN_RIGHT_SHIFT_LOW(p3, p2, b);
            u3 = MPN_RIGHT_SHIFT_LOW(p4, p3, b);
            u4 = MPN_RIGHT_SHIFT_LOW(p5, p4, b);
            u5 = MPN_RIGHT_SHIFT_LOW(wu, p5, b);
            v0 = MPN_RIGHT_SHIFT_LOW(q1, q0, b);
            v1 = MPN_RIGHT_SHIFT_LOW(q2, q1, b);
            v2 = MPN_RIGHT_SHIFT_LOW(q3, q2, b);
            v3 = MPN_RIGHT_SHIFT_LOW(q4, q3, b);
            v4 = MPN_RIGHT_SHIFT_LOW(q5, q4, b);
            v5 = MPN_RIGHT_SHIFT_LOW(UWORD(0), q5, b);
            sub_dddddddmmmmmmmsssssss(bw, e5, e4, e3, e2, e1, e0,
                UWORD(0), t5, t4, t3, t2, t1, t0,
                UWORD(0), Ap[5], Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
            m = ~bw;                /* accept iff no borrow */
            t0 = (t0 & bw) | (e0 & m);
            t1 = (t1 & bw) | (e1 & m);
            t2 = (t2 & bw) | (e2 & m);
            t3 = (t3 & bw) | (e3 & m);
            t4 = (t4 & bw) | (e4 & m);
            t5 = (t5 & bw) | (e5 & m);
            sub_dddddddmmmmmmmsssssss(wu, p5, p4, p3, p2, p1, p0,
                wu, p5, p4, p3, p2, p1, p0,
                UWORD(0), v5 & m, v4 & m, v3 & m, v2 & m, v1 & m, v0 & m);
            add_ssssssaaaaaaaaaaaa(q5, q4, q3, q2, q1, q0,
                q5, q4, q3, q2, q1, q0,
                u5 & m, u4 & m, u3 & m, u2 & m, u1 & m, u0 & m);
            h = t5;
        }
    }

    /* window 1 */
    if (R >= 64)
    {
        nn_srcptr Ap;

        /* boundary step i = 64, twice (truncation creep) */
        Ap = AP(64);
        for (pass = 0; pass < 2; pass++)
        {
            u0 = p1;
            u1 = p2;
            u2 = p3;
            u3 = p4;
            u4 = p5;
            u5 = wu;
            v0 = q1;
            v1 = q2;
            v2 = q3;
            v3 = q4;
            v4 = q5;
            v5 = UWORD(0);
            sub_dddddddmmmmmmmsssssss(bw, e5, e4, e3, e2, e1, e0,
