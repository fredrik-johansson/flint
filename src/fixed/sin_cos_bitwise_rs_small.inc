        for (i = 193; i <= FLINT_MIN(R, 255); i++)
        {
            int b = (int) (i - 192);

            Ap = AP(i);
            lt = Ap[1];
            if (h < lt)
                continue;    /* certain reject */

            u0 = MPN_RIGHT_SHIFT_LOW(p4, p3, b);
            u1 = MPN_RIGHT_SHIFT_LOW(wu, p4, b);
            u2 = UWORD(0);
            u3 = UWORD(0);
            u4 = UWORD(0);
            v0 = MPN_RIGHT_SHIFT_LOW(q4, q3, b);
            v1 = MPN_RIGHT_SHIFT_LOW(UWORD(0), q4, b);
            v2 = UWORD(0);
            v3 = UWORD(0);
            v4 = UWORD(0);
            sub_ddddddmmmmmmssssss(bw, e4, e3, e2, e1, e0,
                UWORD(0), t4, t3, t2, t1, t0,
                UWORD(0), Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
            m = ~bw;                /* accept iff no borrow */
            t0 = (t0 & bw) | (e0 & m);
            t1 = (t1 & bw) | (e1 & m);
            t2 = (t2 & bw) | (e2 & m);
            t3 = (t3 & bw) | (e3 & m);
            t4 = (t4 & bw) | (e4 & m);
            sub_ddddddmmmmmmssssss(wu, p4, p3, p2, p1, p0,
                wu, p4, p3, p2, p1, p0,
                UWORD(0), v4 & m, v3 & m, v2 & m, v1 & m, v0 & m);
            add_sssssaaaaaaaaaa(q4, q3, q2, q1, q0,
                q4, q3, q2, q1, q0,
                u4 & m, u3 & m, u2 & m, u1 & m, u0 & m);
            h = t1;
        }
    }

    /* window 4 */
    if (R >= 256)
    {
        nn_srcptr Ap;

        /* boundary step i = 256, twice (truncation creep) */
        Ap = AP(256);
        for (pass = 0; pass < 2; pass++)
        {
            u0 = p4;
            u1 = wu;
            u2 = UWORD(0);
            u3 = UWORD(0);
            u4 = UWORD(0);
            v0 = q4;
            v1 = UWORD(0);
            v2 = UWORD(0);
            v3 = UWORD(0);
            v4 = UWORD(0);
            sub_ddddddmmmmmmssssss(bw, e4, e3, e2, e1, e0,
                UWORD(0), t4, t3, t2, t1, t0,
                UWORD(0), Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
            m = ~bw;                /* accept iff no borrow */
            t0 = (t0 & bw) | (e0 & m);
            t1 = (t1 & bw) | (e1 & m);
            t2 = (t2 & bw) | (e2 & m);
            t3 = (t3 & bw) | (e3 & m);
            t4 = (t4 & bw) | (e4 & m);
            sub_ddddddmmmmmmssssss(wu, p4, p3, p2, p1, p0,
                wu, p4, p3, p2, p1, p0,
                UWORD(0), v4 & m, v3 & m, v2 & m, v1 & m, v0 & m);
            add_sssssaaaaaaaaaa(q4, q3, q2, q1, q0,
                q4, q3, q2, q1, q0,
                u4 & m, u3 & m, u2 & m, u1 & m, u0 & m);
        }

        h = t0;

        for (i = 257; i <= FLINT_MIN(R, 319); i++)
        {
            int b = (int) (i - 256);

            Ap = AP(i);
            lt = Ap[0];
            if (h < lt)
                continue;    /* certain reject */

            u0 = MPN_RIGHT_SHIFT_LOW(wu, p4, b);
            u1 = UWORD(0);
            u2 = UWORD(0);
            u3 = UWORD(0);
            u4 = UWORD(0);
            v0 = MPN_RIGHT_SHIFT_LOW(UWORD(0), q4, b);
            v1 = UWORD(0);
            v2 = UWORD(0);
            v3 = UWORD(0);
            v4 = UWORD(0);
            sub_ddddddmmmmmmssssss(bw, e4, e3, e2, e1, e0,
                UWORD(0), t4, t3, t2, t1, t0,
                UWORD(0), Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
            m = ~bw;                /* accept iff no borrow */
            t0 = (t0 & bw) | (e0 & m);
            t1 = (t1 & bw) | (e1 & m);
            t2 = (t2 & bw) | (e2 & m);
            t3 = (t3 & bw) | (e3 & m);
            t4 = (t4 & bw) | (e4 & m);
            sub_ddddddmmmmmmssssss(wu, p4, p3, p2, p1, p0,
                wu, p4, p3, p2, p1, p0,
                UWORD(0), v4 & m, v3 & m, v2 & m, v1 & m, v0 & m);
            add_sssssaaaaaaaaaa(q4, q3, q2, q1, q0,
                q4, q3, q2, q1, q0,
                u4 & m, u3 & m, u2 & m, u1 & m, u0 & m);
            h = t0;
        }
    }

    /* the step at i = R, twice (truncation creep) */
    {
        nn_srcptr Ap = AP(R);
        int b = (int) (R & (FLINT_BITS - 1));

        for (pass = 0; pass < 2; pass++)
        {
            switch (R / FLINT_BITS)
            {
            case 0:
                u0 = MPN_RIGHT_SHIFT_LOW(p1, p0, b);
                u1 = MPN_RIGHT_SHIFT_LOW(p2, p1, b);
                u2 = MPN_RIGHT_SHIFT_LOW(p3, p2, b);
                u3 = MPN_RIGHT_SHIFT_LOW(p4, p3, b);
                u4 = MPN_RIGHT_SHIFT_LOW(wu, p4, b);
                v0 = MPN_RIGHT_SHIFT_LOW(q1, q0, b);
                v1 = MPN_RIGHT_SHIFT_LOW(q2, q1, b);
                v2 = MPN_RIGHT_SHIFT_LOW(q3, q2, b);
                v3 = MPN_RIGHT_SHIFT_LOW(q4, q3, b);
                v4 = MPN_RIGHT_SHIFT_LOW(UWORD(0), q4, b);
                sub_ddddddmmmmmmssssss(bw, e4, e3, e2, e1, e0,
                    UWORD(0), t4, t3, t2, t1, t0,
                    UWORD(0), Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
                m = ~bw;                /* accept iff no borrow */
                t0 = (t0 & bw) | (e0 & m);
                t1 = (t1 & bw) | (e1 & m);
                t2 = (t2 & bw) | (e2 & m);
                t3 = (t3 & bw) | (e3 & m);
                t4 = (t4 & bw) | (e4 & m);
                sub_ddddddmmmmmmssssss(wu, p4, p3, p2, p1, p0,
                    wu, p4, p3, p2, p1, p0,
                    UWORD(0), v4 & m, v3 & m, v2 & m, v1 & m, v0 & m);
                add_sssssaaaaaaaaaa(q4, q3, q2, q1, q0,
