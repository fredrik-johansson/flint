                UWORD(0), Ap[5], Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
            m = ~bw;                /* accept iff no borrow */
            t0 = (t0 & bw) | (e0 & m);
            t1 = (t1 & bw) | (e1 & m);
            t2 = (t2 & bw) | (e2 & m);
            t3 = (t3 & bw) | (e3 & m);
            t4 = (t4 & bw) | (e4 & m);
            t5 = (t5 & bw) | (e5 & m);
            sub_dddddddmmmmmmmsssssss(wu, p5, p4, p3, p2, p1, p0,
                wu, p5, p4, p3, p2, p1, p0,
                UWORD(0), v5 & m, v4 & m, v3 & m, v2 & m, v1 & m, v0 & m);
            add_ssssssaaaaaaaaaaaa(q5, q4, q3, q2, q1, q0,
                q5, q4, q3, q2, q1, q0,
                u5 & m, u4 & m, u3 & m, u2 & m, u1 & m, u0 & m);
        }

        h = t4;

        for (i = 65; i <= FLINT_MIN(R, 127); i++)
        {
            int b = (int) (i - 64);

            Ap = AP(i);
            lt = Ap[4];
            if (h < lt)
                continue;    /* certain reject */

            u0 = MPN_RIGHT_SHIFT_LOW(p2, p1, b);
            u1 = MPN_RIGHT_SHIFT_LOW(p3, p2, b);
            u2 = MPN_RIGHT_SHIFT_LOW(p4, p3, b);
            u3 = MPN_RIGHT_SHIFT_LOW(p5, p4, b);
            u4 = MPN_RIGHT_SHIFT_LOW(wu, p5, b);
            u5 = UWORD(0);
            v0 = MPN_RIGHT_SHIFT_LOW(q2, q1, b);
            v1 = MPN_RIGHT_SHIFT_LOW(q3, q2, b);
            v2 = MPN_RIGHT_SHIFT_LOW(q4, q3, b);
            v3 = MPN_RIGHT_SHIFT_LOW(q5, q4, b);
            v4 = MPN_RIGHT_SHIFT_LOW(UWORD(0), q5, b);
            v5 = UWORD(0);
            sub_dddddddmmmmmmmsssssss(bw, e5, e4, e3, e2, e1, e0,
                UWORD(0), t5, t4, t3, t2, t1, t0,
                UWORD(0), Ap[5], Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
            m = ~bw;                /* accept iff no borrow */
            t0 = (t0 & bw) | (e0 & m);
            t1 = (t1 & bw) | (e1 & m);
            t2 = (t2 & bw) | (e2 & m);
            t3 = (t3 & bw) | (e3 & m);
            t4 = (t4 & bw) | (e4 & m);
            t5 = (t5 & bw) | (e5 & m);
            sub_dddddddmmmmmmmsssssss(wu, p5, p4, p3, p2, p1, p0,
                wu, p5, p4, p3, p2, p1, p0,
                UWORD(0), v5 & m, v4 & m, v3 & m, v2 & m, v1 & m, v0 & m);
            add_ssssssaaaaaaaaaaaa(q5, q4, q3, q2, q1, q0,
                q5, q4, q3, q2, q1, q0,
                u5 & m, u4 & m, u3 & m, u2 & m, u1 & m, u0 & m);
            h = t4;
        }
    }

    /* window 2 */
    if (R >= 128)
    {
        nn_srcptr Ap;

        /* boundary step i = 128, twice (truncation creep) */
        Ap = AP(128);
        for (pass = 0; pass < 2; pass++)
        {
            u0 = p2;
            u1 = p3;
            u2 = p4;
            u3 = p5;
            u4 = wu;
            u5 = UWORD(0);
            v0 = q2;
            v1 = q3;
            v2 = q4;
            v3 = q5;
            v4 = UWORD(0);
