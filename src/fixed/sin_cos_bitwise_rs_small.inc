                }
                u0 = MPN_RIGHT_SHIFT_LOW(wu, p4, b);
                u1 = UWORD(0);
                u2 = UWORD(0);
                u3 = UWORD(0);
                u4 = UWORD(0);
                v0 = MPN_RIGHT_SHIFT_LOW(UWORD(0), q4, b);
                v1 = UWORD(0);
                v2 = UWORD(0);
                v3 = UWORD(0);
                v4 = UWORD(0);
                sub_ddddddmmmmmmssssss(bw, e4, e3, e2, e1, e0,
                    UWORD(0), t4, t3, t2, t1, t0,
                    UWORD(0), Ap[4], Ap[3], Ap[2], Ap[1], Ap[0]);
