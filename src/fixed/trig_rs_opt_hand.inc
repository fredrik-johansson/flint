/* Hand-written mixed-precision series for the bitwise trigonometric
   functions, in the manner of exp_rs_opt_hand.inc.

   These are series in z = x^2, so an error at Horner level k is
   attenuated by twice as many powers of x as in the exponential:

       atan(x) = x - x^3 V_0,   V_0 = 1/3 - z(1/5 - z(1/7 - ...))

   giving bits(V_k) = 64 n - 6 - r (2 k + 3), so the level widths
   collapse to one or two limbs within a couple of steps.  Every V_k
   stays positive (z < 2^-2r swamps the alternating term), so no sign
   handling is needed.

   Every operation is chosen by width: one and two limb products are
   inline (n_mulhi and the 2x2 forms of hand_mulhi.inc), only three
   limbs and up reach flint_mpn_mulhigh_n / flint_mpn_sqrhigh, and the
   additions use NN_ADD_k / NN_SUB_k rather than mpn_add_n / mpn_sub_n.
   At n = 1 this leaves no mpn call at all.

   Generated by dev/gen_fixed_trig_hand_mixed.py.  The reduction
   parameters these are built for are hardcoded alongside them (see
   OPT_R in dev/gen_fixed_atan_bitwise_small.py); the series being so
   cheap, the optimum falls to r = 4, 6, 22, 20 for n = 1..4, where the
   generic code wants 16 or 32. */

/* atan, n = 1, r = 4: 7 levels, widths [1, 1, 1, 1, 1, 1, 1] */
void
_fixed_atan_rs_opt_1(nn_ptr res, nn_srcptr x)
{
    ulong z[1], V[1], T[1], P[1], Z[2];
    ulong v, w1, w0, h, l;
    slong i;

    (void) v; (void) w1; (void) w0; (void) h; (void) l;
    (void) i; (void) Z; (void) V; (void) T; (void) P;

    z[0] = n_mulhi(x[0], x[0]);

    v = UWORD(0x1111111111111111);

    /* V_5 = c - z V_6   (1 x 1 limbs) */
    v = n_mulhi(z[0], v);
    v = UWORD(0x13b13b13b13b13b1) - v;

    /* V_4 = c - z V_5   (1 x 1 limbs) */
    v = n_mulhi(z[0], v);
    v = UWORD(0x1745d1745d1745d1) - v;

    /* V_3 = c - z V_4   (1 x 1 limbs) */
    v = n_mulhi(z[0], v);
    v = UWORD(0x1c71c71c71c71c71) - v;

    /* V_2 = c - z V_3   (1 x 1 limbs) */
    v = n_mulhi(z[0], v);
    v = UWORD(0x2492492492492492) - v;

    /* V_1 = c - z V_2   (1 x 1 limbs) */
    v = n_mulhi(z[0], v);
    v = UWORD(0x3333333333333333) - v;

    /* V_0 = c - z V_1   (1 x 1 limbs) */
    v = n_mulhi(z[0], v);
    v = UWORD(0x5555555555555555) - v;

    /* atan = x - x^3 V_0 */
    P[0] = v;
    T[0] = n_mulhi(z[0], x[0]);
    V[0] = n_mulhi(T[0], P[0]);
    res[0] = x[0] - V[0];
}

/* atan, n = 2, r = 6: 9 levels, widths [2, 2, 2, 2, 1, 1, 1, 1, 1] */
void
_fixed_atan_rs_opt_2(nn_ptr res, nn_srcptr x)
{
    ulong z[2], V[2], T[2], P[2], Z[2];
    ulong v, w1, w0, h, l;
    slong i;

    (void) v; (void) w1; (void) w0; (void) h; (void) l;
    (void) i; (void) Z; (void) V; (void) T; (void) P;

    _fixed_sqrhi_2x2(&z[1], &z[0], x[1], x[0]);

    v = UWORD(0x0d79435e50d79435);

    /* V_7 = c - z V_8   (1 x 1 limbs) */
    v = n_mulhi(z[1], v);
    v = UWORD(0x0f0f0f0f0f0f0f0f) - v;

    /* V_6 = c - z V_7   (1 x 1 limbs) */
    v = n_mulhi(z[1], v);
    v = UWORD(0x1111111111111111) - v;

    /* V_5 = c - z V_6   (1 x 1 limbs) */
    v = n_mulhi(z[1], v);
    v = UWORD(0x13b13b13b13b13b1) - v;

    /* V_4 = c - z V_5   (1 x 1 limbs) */
    v = n_mulhi(z[1], v);
    v = UWORD(0x1745d1745d1745d1) - v;

    /* V_3 = c - z V_4   (2 x 1 limbs) */
    _fixed_mulhi_2x1(&h, &l, z[1], z[0], v);
    sub_ddmmss(w1, w0, UWORD(0x1c71c71c71c71c71), UWORD(0xc71c71c71c71c71c), h, l);

    /* V_2 = c - z V_3   (2 x 2 limbs) */
    _fixed_mulhi_2x2_sloppy(&h, &l, z[1], z[0], w1, w0);
    sub_ddmmss(w1, w0, UWORD(0x2492492492492492), UWORD(0x4924924924924924), h, l);

    /* V_1 = c - z V_2   (2 x 2 limbs) */
    _fixed_mulhi_2x2_sloppy(&h, &l, z[1], z[0], w1, w0);
    sub_ddmmss(w1, w0, UWORD(0x3333333333333333), UWORD(0x3333333333333333), h, l);

    /* V_0 = c - z V_1   (2 x 2 limbs) */
    _fixed_mulhi_2x2_sloppy(&h, &l, z[1], z[0], w1, w0);
    sub_ddmmss(w1, w0, UWORD(0x5555555555555555), UWORD(0x5555555555555555), h, l);

    /* atan = x - x^3 V_0 */
    P[0] = w0; P[1] = w1;
    _fixed_mulhi_2x2_sloppy(&T[1], &T[0], z[1], z[0], x[1], x[0]);
    _fixed_mulhi_2x2_sloppy(&V[1], &V[0], T[1], T[0], P[1], P[0]);
    NN_SUB_2(res, x, V);
}

/* atan, n = 3, r = 22: 3 levels, widths [2, 2, 1] */
void
_fixed_atan_rs_opt_3(nn_ptr res, nn_srcptr x)
{
    ulong z[3], V[3], T[3], P[3], Z[2];
    ulong v, w1, w0, h, l;
    slong i;

    (void) v; (void) w1; (void) w0; (void) h; (void) l;
    (void) i; (void) Z; (void) V; (void) T; (void) P;

    flint_mpn_sqrhigh(z, x, 3);

    v = UWORD(0x2492492492492492);

    /* V_1 = c - z V_2   (2 x 1 limbs) */
    _fixed_mulhi_2x1(&h, &l, z[2], z[1], v);
    sub_ddmmss(w1, w0, UWORD(0x3333333333333333), UWORD(0x3333333333333333), h, l);

    /* V_0 = c - z V_1   (2 x 2 limbs) */
    _fixed_mulhi_2x2_sloppy(&h, &l, z[2], z[1], w1, w0);
    sub_ddmmss(w1, w0, UWORD(0x5555555555555555), UWORD(0x5555555555555555), h, l);

    /* atan = x - x^3 V_0 */
    P[0] = UWORD(0);
    P[1] = w0; P[2] = w1;
    flint_mpn_mulhigh_n(T, z, x, 3);
    flint_mpn_mulhigh_n(V, T, P, 3);
    NN_SUB_3(res, x, V);
}

/* atan, n = 4, r = 20: 5 levels, widths [3, 3, 2, 2, 1] */
void
_fixed_atan_rs_opt_4(nn_ptr res, nn_srcptr x)
{
    ulong z[4], V[4], T[4], P[4], Z[2];
    ulong v, w1, w0, h, l;
    slong i;

    (void) v; (void) w1; (void) w0; (void) h; (void) l;
    (void) i; (void) Z; (void) V; (void) T; (void) P;

    flint_mpn_sqrhigh(z, x, 4);

    v = UWORD(0x1745d1745d1745d1);

    /* V_3 = c - z V_4   (2 x 1 limbs) */
    _fixed_mulhi_2x1(&h, &l, z[3], z[2], v);
    sub_ddmmss(w1, w0, UWORD(0x1c71c71c71c71c71), UWORD(0xc71c71c71c71c71c), h, l);

    /* V_2 = c - z V_3   (2 x 2 limbs) */
    _fixed_mulhi_2x2_sloppy(&h, &l, z[3], z[2], w1, w0);
    sub_ddmmss(w1, w0, UWORD(0x2492492492492492), UWORD(0x4924924924924924), h, l);

    /* V_1 = c - z V_2   (3 x 2 limbs) */
    P[0] = UWORD(0);
    P[1] = w0; P[2] = w1;
    flint_mpn_mulhigh_n(T, z + 1, P, 3);
    P[0] = UWORD(0x3333333333333333);
    P[1] = UWORD(0x3333333333333333);
    P[2] = UWORD(0x3333333333333333);
    NN_SUB_3(V, P, T);

    /* V_0 = c - z V_1   (3 x 3 limbs) */
    P[0] = V[0];
    P[1] = V[1];
    P[2] = V[2];
    flint_mpn_mulhigh_n(T, z + 1, P, 3);
    P[0] = UWORD(0x5555555555555555);
    P[1] = UWORD(0x5555555555555555);
    P[2] = UWORD(0x5555555555555555);
    NN_SUB_3(V, P, T);

    /* atan = x - x^3 V_0 */
    P[0] = UWORD(0);
    P[1] = V[0];
    P[2] = V[1];
    P[3] = V[2];
    flint_mpn_mulhigh_n(T, z, x, 4);
    flint_mpn_mulhigh_n(V, T, P, 4);
    NN_SUB_4(res, x, V);
}

/* --- atanh, for the bitwise logarithm (same structure: a series in
   z = x^2, atanh(x) = x + x^3 V_0 with V_0 = 1/3 + z(1/5 + ...)) --- */

/* atanh, n = 2, r = 6: 9 levels, widths [2, 2, 2, 2, 1, 1, 1, 1, 1] */
void
_fixed_atanh_rs_opt_2(nn_ptr res, nn_srcptr x)
{
    ulong z[2], V[2], T[2], P[2], Z[2];
    ulong v, w1, w0, h, l;
    slong i;

    (void) v; (void) w1; (void) w0; (void) h; (void) l;
    (void) i; (void) Z; (void) V; (void) T; (void) P;

    _fixed_sqrhi_2x2(&z[1], &z[0], x[1], x[0]);

    v = UWORD(0x0d79435e50d79435);

    /* V_7 = c + z V_8   (1 x 1 limbs) */
    v = n_mulhi(z[1], v);
    v = UWORD(0x0f0f0f0f0f0f0f0f) + v;

    /* V_6 = c + z V_7   (1 x 1 limbs) */
    v = n_mulhi(z[1], v);
    v = UWORD(0x1111111111111111) + v;

    /* V_5 = c + z V_6   (1 x 1 limbs) */
    v = n_mulhi(z[1], v);
    v = UWORD(0x13b13b13b13b13b1) + v;

    /* V_4 = c + z V_5   (1 x 1 limbs) */
    v = n_mulhi(z[1], v);
    v = UWORD(0x1745d1745d1745d1) + v;

    /* V_3 = c + z V_4   (2 x 1 limbs) */
    _fixed_mulhi_2x1(&h, &l, z[1], z[0], v);
    add_ssaaaa(w1, w0, UWORD(0x1c71c71c71c71c71), UWORD(0xc71c71c71c71c71c), h, l);

    /* V_2 = c + z V_3   (2 x 2 limbs) */
    _fixed_mulhi_2x2_sloppy(&h, &l, z[1], z[0], w1, w0);
    add_ssaaaa(w1, w0, UWORD(0x2492492492492492), UWORD(0x4924924924924924), h, l);

    /* V_1 = c + z V_2   (2 x 2 limbs) */
    _fixed_mulhi_2x2_sloppy(&h, &l, z[1], z[0], w1, w0);
    add_ssaaaa(w1, w0, UWORD(0x3333333333333333), UWORD(0x3333333333333333), h, l);

    /* V_0 = c + z V_1   (2 x 2 limbs) */
    _fixed_mulhi_2x2_sloppy(&h, &l, z[1], z[0], w1, w0);
    add_ssaaaa(w1, w0, UWORD(0x5555555555555555), UWORD(0x5555555555555555), h, l);

    /* atanh = x + x^3 V_0 */
    P[0] = w0; P[1] = w1;
    _fixed_mulhi_2x2_sloppy(&T[1], &T[0], z[1], z[0], x[1], x[0]);
    _fixed_mulhi_2x2_sloppy(&V[1], &V[0], T[1], T[0], P[1], P[0]);
    NN_ADD_2(res, x, V);
}

/* atanh, n = 3, r = 10: 8 levels, widths [3, 3, 2, 2, 2, 1, 1, 1] */
void
_fixed_atanh_rs_opt_3(nn_ptr res, nn_srcptr x)
{
    ulong z[3], V[3], T[3], P[3], Z[2];
    ulong v, w1, w0, h, l;
    slong i;

    (void) v; (void) w1; (void) w0; (void) h; (void) l;
    (void) i; (void) Z; (void) V; (void) T; (void) P;

    flint_mpn_sqrhigh(z, x, 3);

    v = UWORD(0x0f0f0f0f0f0f0f0f);

    /* V_6 = c + z V_7   (1 x 1 limbs) */
    v = n_mulhi(z[2], v);
    v = UWORD(0x1111111111111111) + v;

    /* V_5 = c + z V_6   (1 x 1 limbs) */
    v = n_mulhi(z[2], v);
    v = UWORD(0x13b13b13b13b13b1) + v;

    /* V_4 = c + z V_5   (2 x 1 limbs) */
    _fixed_mulhi_2x1(&h, &l, z[2], z[1], v);
    add_ssaaaa(w1, w0, UWORD(0x1745d1745d1745d1), UWORD(0x745d1745d1745d17), h, l);

    /* V_3 = c + z V_4   (2 x 2 limbs) */
    _fixed_mulhi_2x2_sloppy(&h, &l, z[2], z[1], w1, w0);
    add_ssaaaa(w1, w0, UWORD(0x1c71c71c71c71c71), UWORD(0xc71c71c71c71c71c), h, l);

    /* V_2 = c + z V_3   (2 x 2 limbs) */
    _fixed_mulhi_2x2_sloppy(&h, &l, z[2], z[1], w1, w0);
    add_ssaaaa(w1, w0, UWORD(0x2492492492492492), UWORD(0x4924924924924924), h, l);

    /* V_1 = c + z V_2   (3 x 2 limbs) */
    P[0] = UWORD(0);
    P[1] = w0; P[2] = w1;
    flint_mpn_mulhigh_n(T, z + 0, P, 3);
    P[0] = UWORD(0x3333333333333333);
    P[1] = UWORD(0x3333333333333333);
    P[2] = UWORD(0x3333333333333333);
    NN_ADD_3(V, P, T);

    /* V_0 = c + z V_1   (3 x 3 limbs) */
    P[0] = V[0];
    P[1] = V[1];
    P[2] = V[2];
    flint_mpn_mulhigh_n(T, z + 0, P, 3);
    P[0] = UWORD(0x5555555555555555);
    P[1] = UWORD(0x5555555555555555);
    P[2] = UWORD(0x5555555555555555);
    NN_ADD_3(V, P, T);

    /* atanh = x + x^3 V_0 */
    P[0] = V[0];
    P[1] = V[1];
    P[2] = V[2];
    flint_mpn_mulhigh_n(T, z, x, 3);
    flint_mpn_mulhigh_n(V, T, P, 3);
    NN_ADD_3(res, x, V);
}

/* atanh, n = 4, r = 26: 4 levels, widths [3, 2, 2, 1] */
